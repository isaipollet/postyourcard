# ═══════════════════════════════════════════════
# PostYourCard — Environment Variables
# Copy this file to .env.local and fill in values
# ═══════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Admin Authentication ──
ADMIN_API_KEY=change-me-to-a-random-secret

# ── Stripe (Payments) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary (Image Upload) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-preset
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your-secret

# ── Email (Resend) ──
RESEND_API_KEY=re_...

# ── Print Fulfillment (Prodigi) ──
PRODIGI_API_KEY=your-prodigi-key
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com/v4.0

# ── Cron Jobs ──
CRON_SECRET=your-cron-secret

# ── App URL ──
NEXT_PUBLIC_BASE_URL=https://postyourcard.com
